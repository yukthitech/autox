		<httpclient5.version>5.6.1</httpclient5.version>
		<javaee-api.version>8.0.1</javaee-api.version>
		<jetty.version>9.4.45.v20220203</jetty.version>
		<derby.version>10.14.2.0</derby.version>
		<h2.version>2.1.210</h2.version>
