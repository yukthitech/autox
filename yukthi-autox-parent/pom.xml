		<module>../yukthi-autox-rest</module>
		<module>../yukthi-autox-ui-selenium</module>
		<module>../yukthi-autox-webutils</module>
		<module>../yukthi-autox-mail</module>
		<module>../yukthi-autox-ssh</module>
		<module>../yukthi-autox-mock</module>
		<module>../yukthi-autox-all</module>
		<module>../yukthi-autox</module>
	</modules>
</project>
