<test-file 
	xmlns:s="http://autox.yukthitech.com/steps"
	xmlns:f="http://autox.yukthitech.com/functions" 
	xmlns:wrap="http://xmlbeanparser.yukthitech.com/wrap">
	
	<test-suite name="prefix-test-suite">
		<test-case name="customPrefixTest">
			<description>
				Tests the functionality of custom prefix.
			</description>

			<s:set expression="c:app: test1" value="Value1"/>
			<s:set expression="c:app: test2" value="Value2"/>

			<s:assert-equals actual="c: app: test2" expected="Value2"/>
		</test-case>

		<testCase name="customUiLocators">
			<description>Validates form filling is working</description>
			
			<s:ui-goto-page uri="/form.html" />

			<s:ui-set-value locator="c:srchDropDown : vehicle" value="Rocket"/>
			<s:ui-log-screen-shot name="filledForm-1.png" />

			<s:ui-fill-form locator="id:sampleForm">
				<data>
					{
						"name": "kranthi",
						"id:genderDropDown": "male",
						"address": "line1\nline2",
						"color": ["red", "green", "blue"],
						"c:srchDropDown:vehicle": "Boat",
						"c:srchDropDown:ranking": "Nine"
					}
				</data>
			</s:ui-fill-form>
			
			<s:ui-log-screen-shot name="filledForm.png" />
							
			<s:ui-assert-value locator="xpath: //input[@name='name']" value="kranthi"/>
			<s:ui-assert-value locator="c:srchDropDown: vehicle" value="boat"/>
			<s:ui-assert-value locator="c:srchDropDown: ranking" value="9"/>
		</testCase>

		<testCase name="uiSetValueExpression">
			<description>Validates ui-set-value and ui-assert-value support expression values</description>

			<s:ui-goto-page uri="/form.html" />
			<s:set expression="expectedName" value="exprDynamic"/>
			<s:ui-set-value locator="xpath: //input[@name='name']" value="attr: expectedName"/>
			<s:ui-assert-value locator="xpath: //input[@name='name']" value="attr: expectedName"/>
		</testCase>

		<test-case name="pushPrefixTest">
			<description>
				Tests push: prefix for appending to list/set and merging maps.
			</description>

			<!-- Missing prop + scalar => new list -->
			<s:set expression="push: attr.items" value="a"/>
			<s:assert-equals actual="attr: items" expected="list: a"/>

			<!-- Existing list + scalar => append -->
			<s:set expression="push: attr.items" value="b"/>
			<s:assert-equals actual="attr: items" expected="list: a, b"/>

			<!-- Existing list + list => append all elements -->
			<s:set expression="push: attr.items" value="list: c, d"/>
			<s:assert-equals actual="attr: items" expected="list: a, b, c, d"/>

			<!-- Missing prop + unique=true => new set -->
			<s:set expression="push(unique=true): attr.tags" value="red"/>
			<s:set expression="push: attr.tags" value="list: blue, green"/>
			<s:assert-equals actual="attr: tags" expected="set: red, blue, green"/>

			<!-- Missing prop + map => new map; then merge (overwrite overlapping keys) -->
			<s:set expression="push: attr.config" value="map: a=1, b=2"/>
			<s:assert-equals actual="attr: config" expected="map: a=1, b=2"/>

			<s:set expression="push: attr.config" value="map: b=3, c=4"/>
			<s:assert-equals actual="attr: config" expected="map: a=1, b=3, c=4"/>
		</test-case>

	</test-suite>

</test-file>